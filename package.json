{
  "name": "uoacs-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "types:check": "turbo run types:check",
    "storybook": "turbo run storybook",
    "storybook:build": "turbo run storybook:build",
    "lint:check": "turbo run lint:check //#lint:check:root",
    "lint:fix": "turbo run lint:fix //#lint:fix:root",
    "lint:fix:unsafe": "turbo run lint:fix:unsafe //#lint:fix:unsafe:root",
    "postinstall": "sh -c 'command -v git >/dev/null 2>&1 || exit 0; lefthook install'",
    "lint:check:root": "biome check ./*.json",
    "lint:fix:root": "biome check ./*.json --write",
    "lint:fix:unsafe:root": "biome check ./*.json --write --unsafe"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "lefthook": "^2.1.6",
    "turbo": "^2.10.11",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.17.0"
}
