# Unlike .gitignore, Docker matches these against the whole path relative to the
# build context root, so recursive entries need an explicit **/ prefix. Without
# it a bare `node_modules` only excludes the root one and every workspace
# package's copy still gets uploaded.

# dependencies
**/node_modules
**/.pnp
**/.pnp.js

# testing
**/coverage

# next.js
**/.next
**/out

# production
**/build

# turborepo
**/.turbo

# misc
**/.DS_Store
**/*.pem

# local env files
**/.env
**/.env*.local

# typescript
**/*.tsbuildinfo
**/next-env.d.ts

# ide
**/.vscode
**/.zed

# storybook
**/storybook-static
**/*storybook.log

# vcs / ci
.git
.github
